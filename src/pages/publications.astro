
---
import BaseLayout from '../layouts/BaseLayout.astro';

const publicationCategories = [
  {
    title: 'Research Articles',
    description:
      'Peer-reviewed original research articles published in scientific journals.',
    icon: '01'
  },
  {
    title: 'Review Articles',
    description:
      'Critical reviews and syntheses of scientific literature.',
    icon: '02'
  },
  {
    title: 'Book Chapters',
    description:
      'Scholarly contributions to edited academic books.',
    icon: '03'
  }
];

// Verified publications will be added here later.
const publications = [];
---


<BaseLayout
  title="Publications"
  description="Explore the scientific publications and academic research contributions of Abdul Awal Chowdhury Masud in plant proteomics, agronomy, plant stress physiology, nitrogen metabolism, and sustainable agriculture."
>


  <section class="publications-hero">
    <p class="eyebrow">Scientific Contributions</p>

    <h1>Publications</h1>

    <p class="lead">
      Peer-reviewed research articles, review papers,
      and scholarly book chapters contributing to
      plant science, agronomy, and sustainable agriculture.
    </p>
  </section>

  <section class="publication-section">
    <h2>Publication Categories</h2>

    <div class="category-grid">
      {publicationCategories.map((category) => (
        <article class="category-card">
          <span class="category-number">
            {category.icon}
          </span>

          <h3>{category.title}</h3>
          <p>{category.description}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="publication-section">
    <h2>Publication List</h2>

    {publications.length === 0 ? (
      <div class="empty-state">
        <h3>Publication Records Coming Soon</h3>
        <p>
          My verified publication records,
          including journal details and DOI links,
          will be added to this section.
        </p>
      </div>
    ) : (
      <div class="publication-list">
        {publications.map((publication) => (
          <article class="publication-item">
            <h3>{publication.title}</h3>
          </article>
        ))}
      </div>
    )}
  </section>

  <section class="publication-section">
    <h2>Academic Profiles</h2>

    <p>
      Links to my verified Google Scholar,
      ORCID, and other academic profiles
      will be provided here.
    </p>
  </section>

</BaseLayout>

<style>
  .publications-hero {
    padding: 65px 0 40px;
  }

  .eyebrow {
    color: #087e77;
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 2px;
    text-transform: uppercase;
  }

  .lead {
    max-width: 800px;
    font-size: 1.2rem;
    color: #526477;
  }

  .publication-section {
    padding: 30px 0;
  }

  .category-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
    margin-top: 25px;
  }

  .category-card {
    border: 1px solid #e1e8ed;
    background: #fbfcfd;
    padding: 28px;
    border-radius: 12px;
  }

  .category-number {
    color: #087e77;
    font-weight: 700;
  }

  .category-card h3 {
    color: #163b4b;
    margin-bottom: 10px;
  }

  .empty-state {
    padding: 35px;
    border: 1px dashed #b9cbd0;
    border-radius: 12px;
    background: #f8fafc;
    margin-top: 20px;
  }

  .empty-state h3 {
    margin-top: 0;
  }

  @media (max-width: 768px) {
    .category-grid {
      grid-template-columns: 1fr;
    }

    .publications-hero {
      padding-top: 35px;
    }
  }
</style>
