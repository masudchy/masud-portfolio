
---
import BaseLayout from '../layouts/BaseLayout.astro';

const academicJourney = [
  {
    period: 'Present',
    title: 'PhD Research',
    institution: 'University of Milan, Italy',
    description:
      'Doctoral research in plant proteomics, native protein complexes, and nitrate-responsive molecular processes in maize roots.'
  },
  {
    period: 'Academic Appointment',
    title: 'Assistant Professor',
    institution: 'Sher-e-Bangla Agricultural University, Bangladesh',
    description:
      'Academic engagement in agronomy, agricultural education, and plant science research.'
  },
  {
    period: '2017–2018',
    title: 'International Research Training',
    institution: 'Kagawa University, Japan',
    description:
      'Research training in plant stress physiology, including experimental and laboratory-based approaches.'
  },
  {
    period: '2018',
    title: 'Master of Science in Agronomy',
    institution: 'Sher-e-Bangla Agricultural University',
    description:
      'Postgraduate academic training and research in agronomy.'
  },
  {
    period: '2015',
    title: 'Bachelor of Science in Agriculture',
    institution: 'Sher-e-Bangla Agricultural University',
    description:
      'Undergraduate education in agricultural sciences.'
  }
];

const achievementAreas = [
  {
    title: 'Academic Excellence',
    description:
      'Recognition for academic performance during undergraduate studies.'
  },
  {
    title: 'Research Fellowships',
    description:
      'Research fellowships and training opportunities supporting scientific development.'
  },
  {
    title: 'International Exposure',
    description:
      'Academic and professional learning experiences across international institutions.'
  },
  {
    title: 'Scientific Engagement',
    description:
      'Participation in scientific communication, academic networks, and research activities.'
  }
];
---


<BaseLayout
  title="Academic Achievements"
  description="Explore the academic journey, educational background, research experience, professional milestones, and scholarly achievements of Abdul Awal Chowdhury Masud, a plant scientist and academic at the University of Milan and Sher-e-Bangla Agricultural University."
>


  <section class="page-hero">
    <p class="eyebrow">Academic Milestones</p>

    <h1>Achievements & Academic Journey</h1>

    <p class="lead">
      A journey through academic education,
      research training, teaching, and
      scientific development.
    </p>
  </section>

  <section class="page-section">
    <h2>Academic Journey</h2>

    <div class="timeline">
      {academicJourney.map((item) => (
        <article class="timeline-item">
          <span class="period">{item.period}</span>

          <h3>{item.title}</h3>

          <p class="institution">
            {item.institution}
          </p>

          <p>{item.description}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="page-section">
    <h2>Recognition & Professional Development</h2>

    <div class="achievement-grid">
      {achievementAreas.map((item) => (
        <article class="achievement-card">
          <h3>{item.title}</h3>
          <p>{item.description}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="page-section">
    <h2>Continuing Academic Development</h2>

    <p>
      I remain committed to advancing my
      research expertise, strengthening
      international academic collaboration,
      and contributing to agricultural
      education and scientific innovation.
    </p>
  </section>

</BaseLayout>

<style>
  .page-hero {
    padding: 65px 0 40px;
  }

  .eyebrow {
    color: #087e77;
    font-weight: 700;
    font-size: 0.85rem;
    letter-spacing: 2px;
    text-transform: uppercase;
  }

  .lead {
    max-width: 800px;
    font-size: 1.2rem;
  }

  .page-section {
    padding: 30px 0;
  }

  .timeline {
    border-left: 3px solid #087e77;
    margin: 30px 0 20px 12px;
    padding-left: 30px;
  }

  .timeline-item {
    position: relative;
    padding: 0 0 35px;
  }

  .timeline-item::before {
    content: '';
    position: absolute;
    left: -40px;
    top: 7px;
    width: 15px;
    height: 15px;
    background: #087e77;
    border: 3px solid white;
    border-radius: 50%;
  }

  .period {
    color: #087e77;
    font-size: 0.9rem;
    font-weight: 700;
  }

  .timeline-item h3 {
    margin: 8px 0;
    color: #163b4b;
  }

  .institution {
    font-weight: 600;
  }

  .achievement-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 20px;
    margin-top: 25px;
  }

  .achievement-card {
    padding: 25px;
    border: 1px solid #e1e8ed;
    border-radius: 12px;
    background: #fbfcfd;
  }

  .achievement-card h3 {
    margin-top: 0;
    color: #163b4b;
  }

  @media (max-width: 768px) {
    .page-hero {
      padding-top: 35px;
    }

    .achievement-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
